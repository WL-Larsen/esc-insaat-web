// Cloudflare Workers ayarı. Sayfalar statik dosyalardır; yalnızca yönetim paneli
// (/keystatic, /api/keystatic) Worker üzerinde çalışır. @astrojs/cloudflare derlemede
// bu dosyadan dist/server/wrangler.json üretir (statik dosyalar: dist/client).
// "name", Cloudflare panelindeki Worker adıyla aynı olmalı.
{
  "name": "esc-insaat-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "404-page"
  }
}
