---
import { navigation } from '@/config/navigation';
import { t } from '@/i18n/tr';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 md:flex-row md:items-center md:justify-between">
    <nav aria-label={t.nav.main}>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {navigation.map((item) => (
          <li><a href={item.href} class="text-sm text-slate-600 hover:text-slate-900">{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="text-sm text-slate-500">© {year} {t.site.name}. {t.footer.rights}</p>
  </div>
</footer>
