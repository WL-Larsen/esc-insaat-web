---
import Logo from './Logo.astro';
import Container from './Container.astro';
import Icon from './Icon.astro';
import { navigation } from '@/config/navigation';
import { getSiteSettings } from '@/lib/data';
import { t } from '@/i18n/tr';

const site = await getSiteSettings();
const year = new Date().getFullYear();
const socials = (Object.keys(site.social) as (keyof typeof site.social)[]).filter((k) => site.social[k]);
---

<footer class="bg-navy-950 text-white/70">
  <Container class="grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo variant="white" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed">{site.tagline}</p>
      {socials.length > 0 && (
        <div class="mt-6">
          <p class="sr-only">{t.footer.follow}</p>
          <ul class="flex gap-3">
            {socials.map((key) => (
              <li>
                <a
                  href={site.social[key]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={t.social[key]}
                  class="inline-flex size-10 items-center justify-center rounded-lg bg-white/5 text-white transition-colors hover:bg-brand-700"
                >
                  <Icon name={key} class="size-5" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <nav aria-label={t.footer.pages} class="md:col-span-3">
      <h2 class="text-sm font-semibold text-white">{t.footer.pages}</h2>
      <ul class="mt-4 space-y-3">
        {navigation.map((item) => (
          <li><a href={item.href} class="text-sm hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="md:col-span-4">
      <h2 class="text-sm font-semibold text-white">{t.footer.contact}</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={`mailto:${site.email}`} class="flex items-start gap-3 hover:text-white">
            <Icon name="mail" class="mt-0.5 size-5 shrink-0 text-brand-400" />{site.email}
          </a>
        </li>
        {site.phone && (
          <li>
            <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} class="flex items-start gap-3 hover:text-white">
              <Icon name="phone" class="mt-0.5 size-5 shrink-0 text-brand-400" />{site.phone}
            </a>
          </li>
        )}
        {site.address && (
          <li class="flex items-start gap-3">
            <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-brand-400" />{site.address}
          </li>
        )}
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container class="py-6 text-xs text-white/50">
      {`© ${year} ${site.companyName}. ${t.footer.rights}`}
    </Container>
  </div>
</footer>
