---
import Container from './Container.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { getSiteSettings } from '@/lib/data';
import { t } from '@/i18n/tr';

interface Props {
  title: string;
  text: string;
  subject?: string;
}

const { title, text, subject = t.pages.contact.emailSubject } = Astro.props;
const site = await getSiteSettings();
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<section class="py-16 md:py-24">
  <Container>
    <div class="relative overflow-hidden rounded-2xl bg-brand-700 px-6 py-12 md:px-12 md:py-16">
      <div class="pattern-grid absolute inset-0 opacity-30" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <h2 class="text-2xl font-extrabold tracking-tight text-white text-balance md:text-3xl">{title}</h2>
          <p class="mt-3 text-white/80">{text}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:shrink-0">
          <Button href={mailto} variant="light">
            <Icon name="mail" class="size-5" />
            {t.common.sendEmail}
          </Button>
          <Button href="/iletisim" variant="outlineLight">{t.nav.contact}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
