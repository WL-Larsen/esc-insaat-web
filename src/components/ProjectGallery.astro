---
// Proje sayfası slayt galerisi: yan oklar, küçük önizlemeler, mobilde kaydırma.
// Ana görsele tıklayınca tam ekran görüntüleyici (Lightbox) açılır.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageAsset } from '@/lib/data';
import { t } from '@/i18n/tr';

interface Props {
  images: ImageAsset[];
  title: string;
  isPlaceholder?: boolean;
}

const { images, title, isPlaceholder = false } = Astro.props;
const label = (i: number) => (i === 0 ? title : `${title} — ${t.pages.projects.gallery} ${i}`);
const multiple = images.length > 1;
const arrow =
  'absolute top-1/2 z-10 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-md transition hover:bg-white focus-visible:outline-2 focus-visible:outline-brand-500 md:size-12';
---

<div data-gallery class="select-none">
  <div class="relative aspect-[4/3] overflow-hidden rounded-card bg-surface sm:aspect-[16/10] lg:aspect-[21/9]" data-gallery-stage>
    {images.map((img, i) => (
      <button
        type="button"
        data-slide={i}
        data-lightbox-open={i}
        aria-label={`${t.lightbox.open}: ${label(i)}`}
        class:list={['absolute inset-0 cursor-zoom-in transition-opacity duration-300', i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0']}
        tabindex={i === 0 ? 0 : -1}
        aria-hidden={i === 0 ? undefined : 'true'}
      >
        <Image
          src={img}
          alt={label(i)}
          widths={[640, 1024, 1600, 2200]}
          sizes="(min-width: 1920px) 1700px, (min-width: 1440px) 1344px, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="size-full object-cover"
        />
      </button>
    ))}

    {isPlaceholder && (
      <span class="pointer-events-none absolute bottom-3 left-3 z-10 rounded-md bg-navy-950/75 px-2 py-1 text-xs font-medium text-white backdrop-blur-sm">
        {t.common.placeholderImage}
      </span>
    )}

    {multiple && (
      <>
        <button type="button" data-gallery-prev aria-label={t.lightbox.prev} class:list={[arrow, 'left-3']}>
          <Icon name="arrowLeft" class="size-5" />
        </button>
        <button type="button" data-gallery-next aria-label={t.lightbox.next} class:list={[arrow, 'right-3']}>
          <Icon name="arrowRight" class="size-5" />
        </button>
        <span data-gallery-counter class="pointer-events-none absolute right-3 bottom-3 z-10 rounded-md bg-navy-950/75 px-2 py-1 text-xs font-medium text-white" aria-live="polite">
          1 / {images.length}
        </span>
      </>
    )}
  </div>

  {multiple && (
    <div class="no-scrollbar -mx-1 mt-2 flex gap-2 overflow-x-auto p-1" data-gallery-thumbs>
      {images.map((img, i) => (
        <button
          type="button"
          data-thumb={i}
          aria-label={label(i)}
          aria-current={i === 0 ? 'true' : undefined}
          class="relative h-16 w-24 shrink-0 overflow-hidden rounded-lg opacity-60 ring-brand-700 ring-offset-2 transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-2 sm:h-20 sm:w-28"
        >
          <Image src={img} alt="" width={240} class="size-full object-cover" loading="lazy" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLElement>('[data-thumb]')];
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    if (slides.length < 2) return;
    let index = 0;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const active = n === index;
        s.classList.toggle('opacity-100', active);
        s.classList.toggle('opacity-0', !active);
        s.classList.toggle('pointer-events-none', !active);
        s.tabIndex = active ? 0 : -1;
        if (active) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      thumbs.forEach((th, n) => (n === index ? th.setAttribute('aria-current', 'true') : th.removeAttribute('aria-current')));
      thumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    };

    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));
    thumbs.forEach((th, n) => th.addEventListener('click', () => show(n)));
    document.addEventListener('lightbox:close', (e) => show((e as CustomEvent<number>).detail));
    gallery.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Mobilde kaydırma (kısa dokunuş tıklama sayılır ve görüntüleyiciyi açar)
    const stage = gallery.querySelector<HTMLElement>('[data-gallery-stage]')!;
    let startX = 0;
    let swiped = false;
    stage.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; swiped = false; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { swiped = true; show(index + (dx < 0 ? 1 : -1)); }
    });
    // Kaydırma hareketi görüntüleyiciyi açmasın
    stage.addEventListener('click', (e) => { if (swiped) { e.stopImmediatePropagation(); e.preventDefault(); swiped = false; } }, true);
  });
</script>
