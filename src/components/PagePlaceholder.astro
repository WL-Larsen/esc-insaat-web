---
import { t } from '@/i18n/tr';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-12 md:py-20">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
  <p class="mt-4 text-slate-600">{t.common.comingSoon}</p>
</section>
