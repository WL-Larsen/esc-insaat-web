---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navigation, isActive } from '@/config/navigation';
import { t } from '@/i18n/tr';

const { pathname } = Astro.url;
---

<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Logo />

    <nav aria-label={t.nav.main} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href, pathname) ? 'page' : undefined}
              class="relative py-2 text-sm font-semibold text-muted transition-colors hover:text-ink aria-[current=page]:text-brand-700 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-brand-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden lg:block">
      <Button href="/iletisim" class="min-h-10!">{t.nav.cta}</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 inline-flex size-11 items-center justify-center rounded-lg text-ink lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={t.nav.openMenu}
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path data-icon="open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        <path data-icon="close" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label={t.nav.main} class="border-t border-line bg-white lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      {navigation.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href, pathname) ? 'page' : undefined}
            class="block rounded-lg px-3 py-3 text-base font-semibold text-ink hover:bg-surface aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-2 border-t border-line pt-4 pb-2">
        <Button href="/iletisim" class="w-full">{t.nav.cta}</Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      button.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
      button.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    };

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';

    button.addEventListener('click', () => setOpen(!isOpen()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
