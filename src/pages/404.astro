---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { t } from '@/i18n/tr';
---

<BaseLayout title={t.pages.notFound.title}>
  <Container class="py-20 text-center md:py-32">
    <p class="text-7xl font-extrabold text-brand-100">404</p>
    <h1 class="mt-4 text-2xl font-extrabold tracking-tight md:text-3xl">{t.pages.notFound.title}</h1>
    <p class="mt-3 text-muted">{t.pages.notFound.message}</p>
    <Button href="/" class="mt-8">{t.pages.notFound.backHome}</Button>
  </Container>
</BaseLayout>
