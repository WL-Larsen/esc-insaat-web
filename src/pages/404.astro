---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/tr';
---

<BaseLayout title={t.pages.notFound.title}>
  <section class="mx-auto max-w-6xl px-4 py-16 text-center md:py-24">
    <p class="text-5xl font-bold text-slate-300">404</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight md:text-3xl">{t.pages.notFound.title}</h1>
    <p class="mt-3 text-slate-600">{t.pages.notFound.message}</p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-slate-900 px-5 text-sm font-medium text-white hover:bg-slate-700"
    >
      {t.pages.notFound.backHome}
    </a>
  </section>
</BaseLayout>
