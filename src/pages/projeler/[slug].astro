---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ProjectImage from '@/components/ProjectImage.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Lightbox from '@/components/Lightbox.astro';
import { getImage } from 'astro:assets';
import { getProjects, getSiteSettings, type Project } from '@/lib/data';
import { toParagraphs } from '@/lib/text';
import { t } from '@/i18n/tr';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const site = await getSiteSettings();
const related = (await getProjects()).filter((p) => p.slug !== project.slug && p.category === project.category).slice(0, 3);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`${t.pages.projects.inquirySubject}: ${project.title}`)}`;
const p = t.pages.projects;

// Görüntüleyici: kapak + galeri, büyük boyut
const images = [project.coverImage, ...project.gallery];
const lightboxItems = await Promise.all(
  images.map(async (src, i) => ({
    src: (await getImage({ src, width: 1800 })).src,
    alt: i === 0 ? project.title : `${project.title} — ${p.gallery} ${i}`,
  })),
);
const zoomButton = 'block w-full cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500';

const facts = [
  { label: p.location, value: project.location },
  { label: p.category, value: t.category[project.category] },
  { label: p.year, value: String(project.year) },
];
---

<BaseLayout title={project.title} description={project.summary}>
  <section class="border-b border-line bg-surface">
    <Container class="py-8 md:py-12">
      <a href="/projeler" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:underline">
        <Icon name="arrowLeft" class="size-4" />{p.back}
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <StatusBadge status={project.status} />
        <span class="text-sm text-muted">{t.category[project.category]}</span>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-balance md:text-5xl">{project.title}</h1>
      <p class="mt-3 flex items-center gap-1.5 text-muted">
        <Icon name="pin" class="size-5" />{project.location}
      </p>
    </Container>
  </section>

  <Container class="py-8 md:py-12">
    <button type="button" data-lightbox-open="0" aria-label={`${t.lightbox.open}: ${project.title}`} class:list={[zoomButton, 'rounded-card']}>
      <ProjectImage
        src={project.coverImage}
        alt={project.title}
        isPlaceholder={project.isPlaceholder}
        widths={[640, 1024, 1600, 2200]}
        sizes="(min-width: 1920px) 1700px, (min-width: 1440px) 1344px, 100vw"
        class="aspect-[16/10] rounded-card md:aspect-[21/9]"
        loading="eager"
      />
    </button>

    <div class="mt-10 grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <p class="text-xl font-medium leading-relaxed text-ink">{project.summary}</p>
        <div class="mt-6 space-y-4 leading-relaxed text-muted">
          {toParagraphs(project.description).map((para) => <p>{para}</p>)}
        </div>

        {project.features.length > 0 && (
          <div class="mt-10">
            <h2 class="text-xl font-bold">{p.features}</h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {project.features.map((feature) => (
                <li class="flex items-start gap-3 rounded-lg border border-line p-4 text-sm">
                  <Icon name="check" class="size-5 shrink-0 text-brand-700" />
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-card border border-line p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">{p.details}</h2>
          <dl class="mt-4 divide-y divide-line">
            {facts.map((f) => (
              <div class="flex justify-between gap-4 py-3 text-sm">
                <dt class="text-muted">{f.label}</dt>
                <dd class="text-right font-semibold">{f.value}</dd>
              </div>
            ))}
            <div class="flex items-center justify-between gap-4 py-3 text-sm">
              <dt class="text-muted">{p.status}</dt>
              <dd><StatusBadge status={project.status} /></dd>
            </div>
          </dl>
        </div>
        <div class="rounded-card bg-navy-900 p-6 text-white">
          <h2 class="text-lg font-bold">{p.inquiryTitle}</h2>
          <p class="mt-2 text-sm text-white/70">{p.inquiryText}</p>
          <Button href={mailto} variant="light" class="mt-5 w-full">
            <Icon name="mail" class="size-5" />{t.common.sendEmail}
          </Button>
        </div>
      </aside>
    </div>

    {project.gallery.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-bold">{p.gallery}</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {project.gallery.map((img, i) => (
            <button type="button" data-lightbox-open={i + 1} aria-label={`${t.lightbox.open}: ${p.gallery} ${i + 1}`} class:list={[zoomButton, 'rounded-card']}>
              <ProjectImage src={img} alt={`${project.title} — ${p.gallery} ${i + 1}`} isPlaceholder={project.isPlaceholder} class="aspect-[4/3] rounded-card transition-opacity hover:opacity-90" />
            </button>
          ))}
        </div>
      </section>
    )}
  </Container>

  <Lightbox items={lightboxItems} isPlaceholder={project.isPlaceholder} />

  {related.length > 0 && (
    <section class="border-t border-line bg-surface py-14 md:py-20">
      <Container>
        <h2 class="text-2xl font-extrabold tracking-tight">{p.related}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => <ProjectCard project={r} />)}
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
