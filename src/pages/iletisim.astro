---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import PageHeader from '@/components/PageHeader.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { getSiteSettings } from '@/lib/data';
import { t } from '@/i18n/tr';

const site = await getSiteSettings();
const c = t.pages.contact;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(c.emailSubject)}`;
const socials = (Object.keys(site.social) as (keyof typeof site.social)[]).filter((k) => site.social[k]);

const items = [
  { icon: 'mail', label: c.email, value: site.email, href: mailto },
  { icon: 'phone', label: c.phone, value: site.phone, href: `tel:${site.phone.replace(/[^\d+]/g, '')}` },
  { icon: 'pin', label: c.address, value: site.address },
  { icon: 'clock', label: c.hours, value: site.workingHours },
].filter((item) => item.value);
---

<BaseLayout title={c.title} description={c.description}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} description={c.description} />

  <section class="py-12 md:py-20">
    <Container class="grid gap-8 lg:grid-cols-5">
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-3">
        {items.map((item) => (
          <li class="rounded-card border border-line p-6">
            <span class="inline-flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
              <Icon name={item.icon} />
            </span>
            <h2 class="mt-4 text-sm font-semibold uppercase tracking-wider text-muted">{item.label}</h2>
            {item.href ? (
              <a href={item.href} class="mt-1 block break-words text-lg font-semibold text-ink hover:text-brand-700">{item.value}</a>
            ) : (
              <p class="mt-1 text-lg font-semibold">{item.value}</p>
            )}
          </li>
        ))}
      </ul>

      <div class="rounded-2xl bg-navy-900 p-8 text-white lg:col-span-2">
        <h2 class="text-2xl font-extrabold tracking-tight">{c.ctaTitle}</h2>
        <p class="mt-3 text-white/70">{site.tagline}</p>
        <Button href={mailto} variant="light" class="mt-6 w-full sm:w-auto">
          <Icon name="mail" class="size-5" />{t.common.sendEmail}
        </Button>
        {socials.length > 0 && (
          <div class="mt-8 border-t border-white/10 pt-6">
            <h3 class="text-sm font-semibold">{t.footer.follow}</h3>
            <ul class="mt-4 flex gap-3">
              {socials.map((key) => (
                <li>
                  <a
                    href={site.social[key]}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={t.social[key]}
                    class="inline-flex size-11 items-center justify-center rounded-lg bg-white/10 transition-colors hover:bg-brand-700"
                  >
                    <Icon name={key} class="size-5" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
